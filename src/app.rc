#include <winver.h>
1 ICON "app.ico"
1 24 "app.manifest"
1 VERSIONINFO
FILEVERSION 4,1,0,0
PRODUCTVERSION 4,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040704B0"
    BEGIN
      VALUE "CompanyName", "Buccloud Software (DE)"
      VALUE "ProductName", "Bens Audio Router"
      VALUE "FileDescription", "Bens Audio Router - Audiophiler Node-Router mit Sonos-Streaming"
      VALUE "FileVersion", "4.1.0.0"
      VALUE "ProductVersion", "4.1.0"
      VALUE "InternalName", "BensAudioRouter"
      VALUE "OriginalFilename", "BensAudioRouter.exe"
      VALUE "LegalCopyright", "(C) Ben Buchholz - www.buccloud.de - 2026"
      VALUE "Comments", "Open Source (MIT). AirPlay-Empfaenger (RAOP). Publisher: Buccloud Software (DE). https://www.buccloud.de"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0407, 0x04B0
  END
END
